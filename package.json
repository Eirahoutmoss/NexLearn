{
  "name": "nexlearn",
  "private": true,
  "version": "0.2.0",
  "description": "NexLearn — oku, anla, hatırla, uygula. Ücretsiz, yerel öncelikli öğrenme uygulaması.",
  "author": "Hasan Güler",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs && node scripts/copy-zihin.mjs",
    "prebuild": "node scripts/copy-ocr.mjs && node scripts/copy-zihin.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "tauri": "tauri",
    "android:sync": "node scripts/android-sync.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.2.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/atkinson-hyperlegible": "^5.2.6",
    "@fontsource/literata": "^5.2.6",
    "@fontsource/opendyslexic": "^5.2.5",
    "@tauri-apps/api": "^2.5.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "@wllama/wllama": "3.8.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "homepage": "https://github.com/Eirahoutmoss/NexLearn"
